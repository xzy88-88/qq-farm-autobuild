+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+
+function harness(failRequest) {
+    let releaseBag;
+    const bagPromise = new Promise(resolve => releaseBag = resolve);
+    const generic = new Proxy({}, { get: () => () => {} });
+    const protocol = { create: value => value, encode: () => ({ finish: () => Buffer.alloc(0) }), decode: () => ({ item_uids: [900] }) };
+    const overrides = {
+        '../config/gameConfig': { getItemById: () => ({ type: 17, name: 'fruit' }) },
+        '../utils/utils': { toNum: Number, toLong: Number },
+        '../utils/network': { sendMsgAsync: async () => { if (failRequest) throw new Error('network unavailable'); return { body: Buffer.alloc(0) }; } },
+        '../utils/proto': { types: { LockItemsRequest: protocol, LockItemsReply: protocol } },
+    };
+    const box = { exports: {} };
+    vm.runInNewContext(fs.readFileSync(path.join(__dirname, '../dist/services/warehouse.js'), 'utf8') + '\ngetBag = () => bagPromise;', {
+        require: name => overrides[name] || generic, module: box, exports: box.exports, Buffer, Date, console, setTimeout, clearTimeout, bagPromise,
+    });
+    return { api: box.exports, releaseBag: () => releaseBag({ items: [{ uid: 900, id: 40525, count: 20, locked: false }] }) };
+}
+
+for (const failed of [false, true]) {
+    test(`inventory lock revision begins before reading and is released after ${failed ? 'failure' : 'success'}`, async () => {
+        const h = harness(failed);
+        assert.equal(typeof h.api.getItemLockState, 'function');
+        const before = h.api.getItemLockState();
+        const pending = h.api.setItemsLocked([900], true);
+        const during = h.api.getItemLockState();
+        assert.equal(during.pending, 1);
+        assert.ok(during.revision > before.revision);
+        h.releaseBag();
+        if (failed) await assert.rejects(pending, /network unavailable/);
+        else assert.equal((await pending).changed, 1);
+        assert.equal(h.api.getItemLockState().pending, 0);
+        assert.ok(h.api.getItemLockState().revision > during.revision);
+    });
+}
