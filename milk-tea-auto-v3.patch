diff --git a/core/tests/milk-tea-config.test.js b/core/tests/milk-tea-config.test.js
new file mode 100644
index 0000000..61093bc
--- /dev/null
+++ b/core/tests/milk-tea-config.test.js
@@ -0,0 +1,41 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { normalizeAccountConfig, globalConfig } = require('../dist/models/store/shared-state');
+const { applyConfigSnapshot } = require('../dist/models/store/account-config');
+
+test('milk tea automation is opt-in and remains isolated per account across config round trips', () => {
+    const defaults = normalizeAccountConfig({}).automation;
+    assert.equal(defaults.milk_tea_auto_upgrade, false);
+    assert.equal(defaults.milk_tea_auto_craft, false);
+    assert.equal(defaults.milk_tea_auto_hire, false);
+    assert.equal(defaults.milk_tea_hire_duration, 1);
+    assert.equal(defaults.milk_tea_hire_reserve, 100);
+    try {
+        const first = applyConfigSnapshot({ automation: { milk_tea_auto_upgrade: true, milk_tea_auto_craft: true } }, { accountId: '__milk_a', persist: false });
+        applyConfigSnapshot({ automation: { milk_tea_auto_upgrade: false, milk_tea_auto_craft: false } }, { accountId: '__milk_b', persist: false });
+        assert.equal(first.automation.milk_tea_auto_craft, true);
+        assert.equal(normalizeAccountConfig(globalConfig.accountConfigs.__milk_a).automation.milk_tea_auto_upgrade, true);
+        assert.equal(normalizeAccountConfig(globalConfig.accountConfigs.__milk_b).automation.milk_tea_auto_craft, false);
+    } finally {
+        delete globalConfig.accountConfigs.__milk_a;
+        delete globalConfig.accountConfigs.__milk_b;
+    }
+});
+
+test('hiring settings retain numeric types, validate malformed values and remain isolated across accounts', () => {
+    try {
+        const first = applyConfigSnapshot({ automation: { milk_tea_auto_hire: true, milk_tea_hire_duration: 3, milk_tea_hire_reserve: 300 } }, { accountId: '__hire_a', persist: false });
+        const second = applyConfigSnapshot({ automation: { milk_tea_hire_duration: 2, milk_tea_hire_reserve: 0 } }, { accountId: '__hire_b', persist: false });
+        assert.equal(first.automation.milk_tea_hire_duration, 3);
+        assert.equal(first.automation.milk_tea_hire_reserve, 300);
+        assert.equal(second.automation.milk_tea_auto_hire, false);
+        assert.equal(second.automation.milk_tea_hire_reserve, 0);
+        const invalid = applyConfigSnapshot({ automation: { milk_tea_hire_duration: 99, milk_tea_hire_reserve: -1 } }, { accountId: '__hire_a', persist: false });
+        assert.equal(invalid.automation.milk_tea_hire_duration, 3);
+        assert.equal(invalid.automation.milk_tea_hire_reserve, 300);
+        assert.equal(normalizeAccountConfig(globalConfig.accountConfigs.__hire_b).automation.milk_tea_hire_duration, 2);
+    } finally {
+        delete globalConfig.accountConfigs.__hire_a;
+        delete globalConfig.accountConfigs.__hire_b;
+    }
+});
diff --git a/core/tests/milk-tea-scheduler.test.js b/core/tests/milk-tea-scheduler.test.js
new file mode 100644
index 0000000..6e60980
--- /dev/null
+++ b/core/tests/milk-tea-scheduler.test.js
@@ -0,0 +1,75 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const vm = require('node:vm');
+const path = require('node:path');
+
+function harness() {
+    const timers = new Map();
+    const calls = [];
+    const flags = { milk_tea_auto_craft: true };
+    let pendingGuard;
+    const noop = () => {};
+    const generic = new Proxy({}, { get: (_target, key) => key === 'CONFIG' ? {} : noop });
+    const overrides = {
+        'node:worker_threads': { parentPort: null, workerData: null },
+        '../models/store': { getAutomation: () => flags },
+        '../services/scheduler': { createScheduler: () => ({
+            clear: name => timers.delete(name),
+            setTimeoutTask: (name, delay, run) => timers.set(name, { delay, run }),
+            setIntervalTask: (name, delay, run) => timers.set(name, { delay, run }),
+        }) },
+        '../services/automation-lock': { runExclusiveAutomationTask: async (_name, run) => run() },
+        '../utils/request-context': { runWithRequestClass: (requestClass, run) => { calls.push(requestClass); return run(); } },
+        '../services/milk-tea': { runMilkTeaAutomation: guard => { pendingGuard = guard; if (guard()) calls.push('milk'); } },
+    };
+    const box = { exports: {} };
+    const source = fs.readFileSync(path.join(__dirname, '../dist/core/worker.js'), 'utf8');
+    vm.runInNewContext(source + `
+      module.exports = {
+        start: typeof startMilkTeaTimer === 'function' ? startMilkTeaTimer : () => {},
+        login: ready => { loginReady = ready; runtimeGeneration++; },
+      };
+    `, { require: name => overrides[name] || generic, module: box, exports: box.exports,
+        process: { env: {} }, console, Buffer, Date, setTimeout, clearTimeout });
+    return { api: box.exports, timers, calls, flags, canSend: () => pendingGuard?.() };
+}
+
+test('milk tea timer starts only for logged-in enabled accounts and uses the background request class', async () => {
+    const h = harness();
+    h.api.start();
+    assert.equal(h.timers.size, 0);
+    h.api.login(true); h.api.start();
+    assert.equal(h.timers.get('milk_tea_interval')?.delay, 60000);
+    await h.timers.get('milk_tea_initial').run();
+    assert.deepEqual(h.calls, ['background', 'milk']);
+    h.flags.milk_tea_auto_craft = false; h.api.start();
+    assert.equal(h.timers.size, 0);
+});
+
+test('a callback from an old login generation cannot run milk tea actions', async () => {
+    const h = harness();
+    h.api.login(true); h.api.start();
+    const run = h.timers.get('milk_tea_initial')?.run;
+    assert.equal(typeof run, 'function');
+    h.api.login(false); h.api.login(true);
+    await run();
+    assert.deepEqual(h.calls, []);
+});
+
+test('hire-only accounts receive the existing background timer', async () => {
+    const h = harness(); h.flags.milk_tea_auto_craft = false; h.flags.milk_tea_auto_hire = true;
+    h.api.login(true); h.api.start();
+    assert.equal(h.timers.get('milk_tea_interval')?.delay, 60000);
+    await h.timers.get('milk_tea_initial').run();
+    assert.deepEqual(h.calls, ['background', 'milk']);
+});
+
+test('configuration reload permanently invalidates an in-flight task even if toggles are restored', async () => {
+    const h = harness(); h.api.login(true); h.api.start();
+    await h.timers.get('milk_tea_initial').run();
+    assert.equal(h.canSend(), true);
+    h.flags.milk_tea_auto_craft = false; h.api.start();
+    h.flags.milk_tea_auto_craft = true; h.api.start();
+    assert.equal(h.canSend(), false);
+});
