@@ -0,0 +1,101 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const { createRecoveryFence } = require('../dist/services/network-recovery-fence');
+
+function setup() {
+    const fence = createRecoveryFence();
+    const accounts = [{ id: '2', name: 'existing', platform: 'qq', code: 'old', marker: 'keep' }];
+    let running = false;
+    let stopping = false;
+    let writes = 0;
+    const routes = new Map();
+    const auth = (_req, _res, next) => next();
+    const app = Object.fromEntries(['get', 'post', 'delete'].map(method => [method,
+        (route, ...handlers) => routes.set(method + ' ' + route, handlers)]));
+    const store = {
+        addOrUpdateAccount: data => {
+            Object.assign(accounts.find(a => a.id === data.id), data); writes++;
+            return { accounts };
+        },
+        deleteAccount: id => ({ accounts: accounts.filter(a => a.id !== id) }),
+    };
+    const middleware = {
+        createAuthRequired: () => auth,
+        resolveAccId: (_ctx, ref) => String(ref),
+        getAccountList: () => accounts,
+        handleApiError: (res, e) => res.status(500).json({ ok: false, error: e.message }),
+    };
+    const ctx = { provider: {
+        getAccounts: () => ({ accounts }),
+        isAccountRunning: () => running,
+        canRecoverNetworkAccount: () => running && !stopping,
+        startAccount: () => { running = true; return true; },
+        stopAccount: () => { stopping = true; running = false; return true; },
+        restartAccount: () => { running = true; },
+        addAccountLog: () => {},
+    } };
+    for (const file of ['farm-routes', 'account-routes']) {
+        const module = { exports: {} };
+        const source = fs.readFileSync(path.join(__dirname, '../dist/controllers/admin', file + '.js'), 'utf8');
+        vm.runInNewContext(source, {
+            module, exports: module.exports,
+            require: name => {
+                if (name.endsWith('/models/store')) return store;
+                if (name.endsWith('/services/network-recovery-fence')) return { recoveryFence: fence };
+                if (name === './middleware') return middleware;
+                if (name.endsWith('/services/account-resolver')) return { findAccountByRef: (list, ref) => list.find(a => a.id === String(ref)) };
+                if (name.endsWith('/config/config') || name.endsWith('/config/gameConfig')) return {};
+                throw new Error('Unexpected route dependency ' + name);
+            },
+        });
+        module.exports[file === 'farm-routes' ? 'mountFarmRoutes' : 'mountAccountRoutes'](app, ctx);
+    }
+    const call = (method, route, body = {}) => {
+        let result;
+        let status = 200;
+        const res = { status: value => { status = value; return res; }, json: value => { result = value; return res; } };
+        const handlers = routes.get(method + ' ' + route);
+        handlers.at(-1)({ params: { id: '2' }, body, headers: {}, query: {} }, res);
+        return { status, result };
+    };
+    return { call, accounts, routes, auth, running: () => running, writes: () => writes,
+        setRunning: value => { running = value; }, setStopping: value => { stopping = value; } };
+}
+
+const STATE = '/api/accounts/:id/network-recovery-state';
+const RECOVER = '/api/accounts/:id/recover-network';
+
+test('new recovery endpoints require authentication and atomic operation preserves fields', () => {
+    const f = setup();
+    assert.equal(f.routes.get('get ' + STATE)[0], f.auth);
+    assert.equal(f.routes.get('post ' + RECOVER)[0], f.auth);
+    const expected = f.call('get', STATE).result.data.fence;
+    assert.equal(f.call('post', RECOVER, { expected, code: 'fresh' }).status, 200);
+    assert.equal(f.accounts[0].marker, 'keep');
+    assert.equal(f.accounts[0].code, 'fresh');
+    assert.equal(f.running(), true);
+});
+
+test('real Stop route invalidates recovery even for an already stopped account', () => {
+    const f = setup(); const expected = f.call('get', STATE).result.data.fence;
+    assert.equal(f.call('post', '/api/accounts/:id/stop').status, 200);
+    assert.equal(f.call('post', RECOVER, { expected, code: 'fresh' }).status, 409);
+    assert.equal(f.writes(), 0);
+    assert.equal(f.running(), false);
+});
+
+test('real account update route invalidates snapshot and preserves user authorization', () => {
+    const f = setup(); const expected = f.call('get', STATE).result.data.fence;
+    const update = f.call('post', '/api/accounts', { id: '2', name: 'existing', code: 'user-code' });
+    assert.equal(update.status, 200);
+    assert.equal(f.call('post', RECOVER, { expected, code: 'fresh' }).status, 409);
+    assert.equal(f.accounts[0].code, 'user-code');
+});
+
+test('snapshot does not arm a stopping worker with stale connected status', () => {
+    const f = setup(); f.setRunning(true); f.setStopping(true);
+    assert.equal(f.call('get', STATE).result.data.online, false);
+});
diff --git a/core/tests/network-send-guard.test.js b/core/tests/network-send-guard.test.js
new file mode 100644
index 0000000..ecf4371
--- /dev/null
+++ b/core/tests/network-send-guard.test.js
@@ -0,0 +1,77 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const { createRequire } = require('node:module');
+
+function harness({ pauseEncoding = false } = {}) {
+    const file = path.resolve(__dirname, '../dist/utils/network.js');
+    const realRequire = createRequire(file);
+    const priority = realRequire('./request-priority');
+    let dispatch = false;
+    let finishEncoding;
+    const encoding = pauseEncoding ? new Promise(resolve => finishEncoding = resolve) : Promise.resolve();
+    const packets = [];
+    const box = { exports: {} };
+    const overrides = {
+        ws: { OPEN: 1 },
+        '../services/scheduler': { createScheduler: () => ({ clear() {}, clearAll() {}, setTimeoutTask() {} }) },
+        './request-priority': { ...priority, selectDispatchIndex: (...args) => dispatch ? priority.selectDispatchIndex(...args) : -1 },
+    };
+    vm.runInNewContext(fs.readFileSync(file, 'utf8') + `
+        ws = { readyState: 1, send: packet => packets.push(packet) };
+        currentConnection = { socket: ws, phase: 'online', finalized: false };
+        encodeMsg = async () => { await encoding; return Buffer.from('fixture'); };
+        module.exports.flush = drainRequestQueue;
+    `, { require: name => overrides[name] || realRequire(name), module: box, exports: box.exports,
+        Buffer, console, process, Date, packets, encoding });
+    return { api: box.exports, packets, flush: () => { dispatch = true; box.exports.flush(); }, finishEncoding };
+}
+
+test('queued background writes recheck their guard before sending after a switch is disabled', async () => {
+    const h = harness();
+    let enabled = true;
+    const pending = h.api.sendMsgAsync('fixture.Service', 'Craft', Buffer.alloc(0), { expectReply: false, requestClass: 'background', beforeSend: () => enabled });
+    enabled = false;
+    h.flush();
+    await assert.rejects(pending, /取消/);
+    assert.equal(h.packets.length, 0);
+});
+
+test('a switch disabled during asynchronous encoding still prevents the socket write', async () => {
+    const h = harness({ pauseEncoding: true });
+    let enabled = true;
+    const pending = h.api.sendMsgAsync('fixture.Service', 'Craft', Buffer.alloc(0), { expectReply: false, beforeSend: () => enabled });
+    h.flush();
+    enabled = false;
+    h.finishEncoding();
+    await assert.rejects(pending, /取消/);
+    assert.equal(h.packets.length, 0);
+});
+
+test('an enabled guarded write retains ordinary network dispatch behavior', async () => {
+    const h = harness();
+    const pending = h.api.sendMsgAsync('fixture.Service', 'Craft', Buffer.alloc(0), { expectReply: false, beforeSend: () => true });
+    h.flush();
+    await pending;
+    assert.equal(h.packets.length, 1);
+});
+
+test('cancelling a reply-bearing write releases its pending slot and allows subsequent requests', async () => {
+    for (const throws of [false, true]) {
+        const h = harness({ pauseEncoding: true });
+        const pending = h.api.sendMsgAsync('fixture.Service', 'Craft', Buffer.alloc(0), { beforeSend: () => {
+            if (throws) throw new Error('guard cancelled');
+            return false;
+        } });
+        h.flush();
+        assert.equal(h.api.getGatewayLoad().pending, 1);
+        h.finishEncoding();
+        await assert.rejects(pending);
+        assert.equal(h.api.getGatewayLoad().pending, 0);
+        assert.equal(h.api.getGatewayLoad().queued, 0);
+        await h.api.sendMsgAsync('fixture.Service', 'Read', Buffer.alloc(0), { expectReply: false });
+        assert.equal(h.packets.length, 1);
+    }
+});
diff --git a/core/tests/warehouse-lock-coordination.test.js b/core/tests/warehouse-lock-coordination.test.js
new file mode 100644
index 0000000..8647299
--- /dev/null
+++ b/core/tests/warehouse-lock-coordination.test.js
@@ -0,0 +1,40 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+
+function harness(failRequest) {
+    let releaseBag;
+    const bagPromise = new Promise(resolve => releaseBag = resolve);
+    const generic = new Proxy({}, { get: () => () => {} });
+    const protocol = { create: value => value, encode: () => ({ finish: () => Buffer.alloc(0) }), decode: () => ({ item_uids: [900] }) };
+    const overrides = {
+        '../config/gameConfig': { getItemById: () => ({ type: 17, name: 'fruit' }) },
+        '../utils/utils': { toNum: Number, toLong: Number },
+        '../utils/network': { sendMsgAsync: async () => { if (failRequest) throw new Error('network unavailable'); return { body: Buffer.alloc(0) }; } },
+        '../utils/proto': { types: { LockItemsRequest: protocol, LockItemsReply: protocol } },
+    };
+    const box = { exports: {} };
+    vm.runInNewContext(fs.readFileSync(path.join(__dirname, '../dist/services/warehouse.js'), 'utf8') + '\ngetBag = () => bagPromise;', {
+        require: name => overrides[name] || generic, module: box, exports: box.exports, Buffer, Date, console, setTimeout, clearTimeout, bagPromise,
+    });
+    return { api: box.exports, releaseBag: () => releaseBag({ items: [{ uid: 900, id: 40525, count: 20, locked: false }] }) };
+}
+
+for (const failed of [false, true]) {
+    test(`inventory lock revision begins before reading and is released after ${failed ? 'failure' : 'success'}`, async () => {
+        const h = harness(failed);
+        assert.equal(typeof h.api.getItemLockState, 'function');
+        const before = h.api.getItemLockState();
+        const pending = h.api.setItemsLocked([900], true);
+        const during = h.api.getItemLockState();
+        assert.equal(during.pending, 1);
+        assert.ok(during.revision > before.revision);
+        h.releaseBag();
+        if (failed) await assert.rejects(pending, /network unavailable/);
+        else assert.equal((await pending).changed, 1);
+        assert.equal(h.api.getItemLockState().pending, 0);
+        assert.ok(h.api.getItemLockState().revision > during.revision);
+    });
+}
