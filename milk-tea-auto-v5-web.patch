+      </a>
+      <a class="row-link" href="/settings">
+        <span class="ico">⚙️</span>
+        <span class="txt">系统设置<small>自动控制、推送、登录配置</small></span>
+        <span class="arrow">›</span>
+      </a>
+      <a class="row-link" href="/accounts">
+        <span class="ico">👤</span>
+        <span class="txt">账号管理<small>添加账号、扫码登录、备注</small></span>
+        <span class="arrow">›</span>
+      </a>
+    </div>
+    <div class="card">
+      <div class="row-link" style="border:0;padding:6px 2px">
+        <span class="ico">📦</span>
+        <span class="txt">后端版本<small id="verText">读取中…</small></span>
+      </div>
+      <div class="row-link" style="border:0;padding:6px 2px">
+        <span class="ico">📲</span>
+        <span class="txt">装到桌面<small>iPhone：分享 → 添加到主屏幕；Android：浏览器菜单 → 添加到主屏幕</small></span>
+      </div>
+      <button class="btn btn-ghost" id="logout" style="width:100%;margin-top:12px">退出登录</button>
+    </div>
+  </section>
+</main>
+
+<nav class="tabs">
+  <button data-view="accounts" class="active">
+    <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M2.8 20a6.2 6.2 0 0 1 12.4 0" stroke-linecap="round"/><path d="M16.5 5.4a3.2 3.2 0 0 1 0 5.2M18.2 20a6.4 6.4 0 0 0-1.6-4.2" stroke-linecap="round"/></svg>
+    账号
+  </button>
+  <button data-view="logs">
+    <svg viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13" stroke-linecap="round"/><path d="M3.5 6h.01M3.5 12h.01M3.5 18h.01" stroke-linecap="round"/></svg>
+    日志
+  </button>
+  <button data-view="more">
+    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1" stroke-linecap="round"/></svg>
+    更多
+  </button>
+</nav>
+
+<div class="toast" id="toast"></div>
+
+<script>
+(function () {
+  'use strict';
+
+  var TOKEN_KEY = 'admin_token';
+  var ACCOUNT_KEY = 'current_account_id';
+  var BASE = 'http://8.133.176.148:3007';
+  var NATIVE = typeof window.FarmNative !== 'undefined';
+  var IMG_BASE = NATIVE ? BASE : '';
+
+  var state = {
+    token: localStorage.getItem(TOKEN_KEY) || '',
+    accountId: localStorage.getItem(ACCOUNT_KEY) || '',
+    accounts: [],
+    timer: null,
+    busy: {},
+  };
+
+  var $ = function (id) { return document.getElementById(id); };
+  var esc = function (v) {
+    return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) {
+      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
+    });
+  };
+
+  // ---- 网络层：网页走 fetch，原生壳走 JS 桥（避免跨域与明文限制）----
+  var seq = 0;
+  var pending = {};
+
+  window.__FarmApiDone = function (id, status, text, err) {
+    var slot = pending[id];
+    if (!slot) return;
+    delete pending[id];
+    if (err) { slot.reject(new Error(err)); return; }
+    var data = null;
+    try { data = text ? JSON.parse(text) : null; } catch (e) { data = null; }
+    if (status === 401) {
+      var unauth = new Error('unauthorized');
+      unauth.unauthorized = true;
+      slot.reject(unauth);
+      return;
+    }
+    if (status >= 400 || (data && data.ok === false)) {
+      slot.reject(new Error((data && (data.errorMessage || data.error || data.message)) || ('请求失败 ' + status)));
+      return;
+    }
+    slot.resolve(data);
+  };
+
+  function request(method, path, body) {
+    if (!NATIVE) {
+      var headers = {};
+      if (state.token) headers['x-admin-token'] = state.token;
+      if (state.accountId) headers['x-account-id'] = state.accountId;
+      var init = { method: method, headers: headers };
+      if (body !== undefined && body !== null) {
+        headers['Content-Type'] = 'application/json';
+        init.body = JSON.stringify(body);
+      }
+      return fetch(path, init).then(function (res) {
+        if (res.status === 401) {
+          var e = new Error('unauthorized'); e.unauthorized = true; throw e;
+        }
+        return res.json().catch(function () { return null; }).then(function (data) {
+          if (!res.ok || (data && data.ok === false)) {
+            throw new Error((data && (data.errorMessage || data.error || data.message)) || ('请求失败 ' + res.status));
+          }
+          return data;
+        });
+      });
+    }
+    return new Promise(function (resolve, reject) {
+      var id = 'r' + (++seq);
+      pending[id] = { resolve: resolve, reject: reject };
+      try {
+        window.FarmNative.request(id, method, path, body == null ? '' : JSON.stringify(body), state.token || '', state.accountId || '');
+      } catch (err) {
+        delete pending[id];
+        reject(err);
+      }
+    });
+  }
+
+  function toast(msg) {
+    if (NATIVE && window.FarmNative.toast) { window.FarmNative.toast(String(msg)); return; }
+    var el = $('toast');
+    el.textContent = msg;
+    el.classList.add('show');
+    clearTimeout(toast._t);
+    toast._t = setTimeout(function () { el.classList.remove('show'); }, 2000);
+  }
+
+  function setConn(ok, text) {
+    $('conn').className = 'dot ' + (ok ? 'on' : 'off');
+    $('connText').textContent = text;
+  }
+
+  function showLogin(message) {
+    state.token = '';
+    localStorage.removeItem(TOKEN_KEY);
+    document.body.classList.add('logged-out');
+    $('view-login').classList.add('active');
+    document.querySelectorAll('main > section').forEach(function (s) {
+      if (s.id !== 'view-login') s.classList.remove('active');
+    });
+    $('loginErr').textContent = message || '';
+    setConn(false, '未登录');
+  }
+
+  function renderAccounts() {
+    var box = $('accounts');
+    if (!state.accounts.length) {
+      box.innerHTML = '<div class="card"><div class="empty">还没有账号' + (NATIVE ? '，请在浏览器打开完整面板添加' : '，去「账号管理」添加') + '</div></div>';
+      $('accountsHint').textContent = '共 0 个账号';
+      return;
+    }
+    $('accountsHint').textContent = '共 ' + state.accounts.length + ' 个账号 · 每 10 秒自动刷新';
+    box.innerHTML = state.accounts.map(function (a) {
+      var running = !!a.running;
+      var name = a.name || a.nick || ('账号 ' + a.id);
+      var platform = a.platform === 'wx' ? '微信' : a.platform === 'qq' ? 'QQ' : '';
+      var meta = [];
+      if (a.nick && a.nick !== name) meta.push(a.nick);
+      if (a.uin) meta.push('UIN ' + a.uin);
+      var busy = !!state.busy[a.id];
+      var avatarSrc = a.avatar ? (/^https?:/i.test(a.avatar) ? a.avatar : IMG_BASE + a.avatar) : '';
+      var avatar = avatarSrc
+        ? '<img class="avatar" data-avatar="1" src="' + esc(avatarSrc) + '" alt="" referrerpolicy="no-referrer" />'
+        : '<div class="avatar">🌱</div>';
+      return '<div class="card">' +
+        '<div class="acct">' + avatar +
+          '<div class="who">' +
+            '<div class="name">' + esc(name) +
+              (platform ? ' <span class="chip">' + platform + '</span>' : '') +
+            '</div>' +
+            '<div class="meta">' + (meta.length ? esc(meta.join(' · ')) : 'ID ' + esc(a.id)) +
+              ' · <span style="color:' + (running ? 'var(--green)' : 'var(--muted)') + '">' + (running ? '运行中' : '已停止') + '</span>' +
+            '</div>' +
+          '</div>' +
+        '</div>' +
+        '<div class="actions">' +
+          (running
+            ? '<button class="btn btn-danger" data-act="stop" data-id="' + esc(a.id) + '"' + (busy ? ' disabled' : '') + '>停止挂机</button>'
+            : '<button class="btn btn-primary" data-act="start" data-id="' + esc(a.id) + '"' + (busy ? ' disabled' : '') + '>开始挂机</button>') +
+          '<button class="btn btn-ghost" data-act="logs" data-id="' + esc(a.id) + '">看日志</button>' +
+        '</div>' +
+      '</div>';
+    }).join('');
+  }
+
+  function loadAccounts(quiet) {
+    if (!state.token) { showLogin(); return Promise.resolve(); }
+    if (!quiet) $('refresh').firstElementChild.classList.add('spin');
+    return request('GET', '/api/accounts').then(function (res) {
+      var data = (res && res.data) || {};
+      state.accounts = Array.isArray(data.accounts) ? data.accounts : [];
+      if (!state.accountId && state.accounts.length) {
+        state.accountId = String(state.accounts[0].id);
+        localStorage.setItem(ACCOUNT_KEY, state.accountId);
+      }
+      renderAccounts();
+      setConn(true, '已连接 · ' + state.accounts.length + ' 个账号');
+    }).catch(function (err) {
+      if (err.unauthorized) { showLogin('登录已过期，请重新登录'); return; }
+      setConn(false, err.message || '连接失败');
+      if (!quiet) toast(err.message || '连接失败');
+    }).finally(function () {
+      $('refresh').firstElementChild.classList.remove('spin');
+    });
+  }
+
+  function loadLogs(limit) {
+    var box = $('logs');
+    box.innerHTML = '<div class="empty">读取中…</div>';
+    return request('GET', '/api/account-logs?limit=' + (limit || 40)).then(function (list) {
+      if (!Array.isArray(list) || !list.length) {
+        box.innerHTML = '<div class="empty">暂无日志</div>';
+        return;
+      }
+      box.innerHTML = list.map(function (item) {
+        var t = String(item.time || '');
+        var hhmm = t.length >= 16 ? t.slice(11, 16) : t;
+        return '<div class="log">' +
+          '<time>' + esc(hhmm) + '</time>' +
+          '<div class="body">' +
+            '<div class="tag">' + esc(item.action || '') + '</div>' +
+            '<div class="msg">' + esc(item.msg || '') + '</div>' +
+            (item.reason ? '<div class="reason">' + esc(item.reason) + '</div>' : '') +
+          '</div>' +
+        '</div>';
+      }).join('');
+    }).catch(function (err) {
+      box.innerHTML = '<div class="empty">' + esc(err.message || '读取失败') + '</div>';
+    });
+  }
+
+  function loadVersion() {
+    var line = $('serverLine');
+    if (line) { line.className = 'server-line'; line.textContent = '正在连接服务器…'; }
+    request('GET', '/api/game-version').then(function (d) {
+      $('verText').textContent = '面板 ' + (d.botVersion || '?') + ' · 客户端 ' + (d.clientVersion || '?');
+      if (line) {
+        line.className = 'server-line ok';
+        line.textContent = '服务器已连接 · 面板 ' + (d.botVersion || '?');
+      }
+    }).catch(function () {
+      $('verText').textContent = '读取失败';
+      if (line) {
+        line.className = 'server-line bad';
+        line.textContent = '无法连接服务器，请检查网络';
+      }
+    });
+  }
+
+  function control(id, act) {
+    if (state.busy[id]) return;
+    if (act === 'stop' && !confirm('确定停止这个账号的挂机吗？')) return;
+    state.busy[id] = true;
+    renderAccounts();
+    request('POST', '/api/accounts/' + encodeURIComponent(id) + '/' + act, {})
+      .then(function () {
+        toast(act === 'start' ? '已开始挂机' : '已停止挂机');
+        return loadAccounts(true);
+      })
+      .catch(function (err) {
+        toast(err.message || '操作失败');
+      })
+      .finally(function () {
+        delete state.busy[id];
+        renderAccounts();
+      });
+  }
+
+  function switchView(view) {
+    document.querySelectorAll('main > section').forEach(function (s) {
+      s.classList.toggle('active', s.id === 'view-' + view);
+    });
+    document.querySelectorAll('.tabs button').forEach(function (b) {
+      b.classList.toggle('active', b.dataset.view === view);
+    });
+    if (view === 'logs' && state.token) loadLogs();
+    if (view === 'more') loadVersion();
+    window.scrollTo(0, 0);
+  }
+
+  document.querySelectorAll('.tabs button').forEach(function (b) {
+    b.addEventListener('click', function () { switchView(b.dataset.view); });
+  });
+
+  $('refresh').addEventListener('click', function () {
+    loadAccounts();
+    if ($('view-logs').classList.contains('active')) loadLogs();
+    toast('已刷新');
+  });
+
+  $('accounts').addEventListener('error', function (e) {
+    var t = e.target;
+    if (!t || !t.dataset || !t.dataset.avatar) return;
+    var d = document.createElement('div');
+    d.className = 'avatar';
+    d.textContent = '🌱';
+    t.replaceWith(d);
+  }, true);
+
+  $('accounts').addEventListener('click', function (e) {
+    var btn = e.target.closest('button[data-act]');
+    if (!btn) return;
+    var id = btn.dataset.id;
+    var act = btn.dataset.act;
+    if (act === 'logs') {
+      state.accountId = String(id);
+      localStorage.setItem(ACCOUNT_KEY, state.accountId);
+      switchView('logs');
+      return;
+    }
+    control(id, act);
+  });
+
+  $('loginForm').addEventListener('submit', function (e) {
+    e.preventDefault();
+    var username = $('u').value.trim();
+    var password = $('p').value;
+    if (!username || !password) { $('loginErr').textContent = '请输入用户名和密码'; return; }
+    $('loginBtn').disabled = true;
+    $('loginErr').textContent = '';
+    request('POST', '/api/login', { username: username, password: password }).then(function (r) {
+      if (!r || !r.ok || !r.data || !r.data.token) throw new Error('登录失败');
+      state.token = r.data.token;
+      localStorage.setItem(TOKEN_KEY, state.token);
+      document.body.classList.remove('logged-out');
+      $('p').value = '';
+      switchView('accounts');
+      return loadAccounts();
+    }).catch(function (err) {
+      $('loginErr').textContent = err.message || '登录失败';
+    }).finally(function () {
+      $('loginBtn').disabled = false;
+    });
+  });
+
+  $('logout').addEventListener('click', function () {
+    if (!confirm('退出登录？下次需要重新输入密码。')) return;
+    request('POST', '/api/logout', {}).catch(function () {});
+    showLogin('');
+  });
+
+  // 原生壳：站内链接交给系统浏览器打开完整面板
+  if (NATIVE) {
+    document.querySelectorAll('a.row-link').forEach(function (a) {
+      a.addEventListener('click', function (e) {
+        e.preventDefault();
+        var href = a.getAttribute('href') || '/';
+        var url = /^https?:/i.test(href) ? href : BASE + href;
+        if (window.FarmNative.openUrl) window.FarmNative.openUrl(url);
+      });
+    });
+    var hint = Array.prototype.slice.call(document.querySelectorAll('.row-link')).filter(function (el) {
+      return el.textContent.indexOf('装到桌面') >= 0;
+    })[0];
+    if (hint) hint.style.display = 'none';
+  }
+
+  function startTimer() {
+    clearInterval(state.timer);
+    state.timer = setInterval(function () {
+      if (document.hidden || !state.token) return;
+      if ($('view-accounts').classList.contains('active')) loadAccounts(true);
+      else if ($('view-logs').classList.contains('active')) loadLogs();
+    }, 10000);
+  }
+  document.addEventListener('visibilitychange', function () {
+    if (!document.hidden && state.token && $('view-accounts').classList.contains('active')) loadAccounts(true);
+  });
+
+  if (state.token) { switchView('accounts'); loadAccounts(); } else { showLogin(''); }
+  loadVersion();
+  startTimer();
+})();
+
+</script>
+</body>
+</html>
