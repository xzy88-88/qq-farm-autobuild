--- /dev/null
+++ b/core/tests/friend-not-friend-retry.test.js
@@ -0,0 +1,120 @@
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const test = require('node:test');
+
+// Exercise the real visit strategy. Only its service boundaries and clock are replaced;
+// no requests, account settings, or persistent friend lists are changed by these tests.
+function harness() {
+    let now = 1000000;
+    let failure = () => Object.assign(new Error('不是好友无法操作'), { code: 1001048 });
+    const calls = { enter: [], leave: [], farming: [], steal: [], bad: [], lists: 0, settings: [], logs: [], stats: [] };
+    const flags = { friend_help: true, friend_help_exp_limit: false, friend_steal: false, friend_bad: false };
+    const friends = [{ gid: 20, name: 'target' }, { gid: 21, name: 'other' }];
+    const lands = [1, 2].map(id => ({ id, plant: { id: 10, phases: [{ phase: 2 }], dry_num: 1 } }));
+    const successful = ids => ({ effect: 'confirmed', operationCount: ids.length, landCount: ids.length, landIds: ids, operationLimits: [], dogSkillGiftCount: 0 });
+    const modules = {
+        '../../config/config': { PlantPhase: { MATURE: 6, DEAD: 7 } },
+        '../../config/gameConfig': { getPlantName: () => 'plant', getPlantById: () => ({}), getItemById: () => ({}), getItemImageById: () => '' },
+        '../../models/store': { isAutomationOn: key => flags[key], getFriendQuietHours: () => ({}), getFriendBlacklist: () => [], getPlantBlacklist: () => [], getFriendsListCacheTtlSec: () => 60 },
+        '../../utils/network': { getUserState: () => ({ gid: 999, accountId: 'test' }) },
+        '../../utils/utils': { toNum: v => Number(v) || 0, getServerTimeSec: () => now / 1000, getSystemClockMinutes: () => 0,
+            log: (...args) => calls.logs.push(args), logWarn: (...args) => calls.logs.push(args), sleep: async () => {}, randomDelay: async () => {} },
+        '../farm': { getCurrentPhase: phases => phases[0], buildLandMap: () => new Map(), buildLandDetail: () => ({}),
+            getPlantStatusFlags: plant => ({ needWater: !!plant.dry_num }), isOccupiedSlaveLand: () => false },
+        '../career': { getCareerInfoOrNull: () => null }, '../stats': { recordOperation: (...args) => calls.stats.push(args) },
+        '../warehouse': { sellAllFruits: async () => {} },
+        './api': {
+            getAllFriends: async () => { calls.lists++; return { friends }; },
+            enterFriendFarm: async gid => { calls.enter.push(gid); return { lands }; },
+            leaveFriendFarm: async gid => { calls.leave.push(gid); },
+            helpFarming: async (gid, ids) => { calls.farming.push({ gid, ids: Array.from(ids) }); const error = failure(gid, ids); if (error) throw error; return successful(ids); },
+            stealHarvest: async gid => { calls.steal.push(gid); },
+            putInsects: async gid => { calls.bad.push(gid); return 1; },
+            putWeeds: async gid => { calls.bad.push(gid); return 1; },
+        },
+        './gid-manager': { extractReplyFriends: reply => reply.friends || [], postToMaster: value => { calls.settings.push(value); return true; }, removeKnownFriendGid: (...args) => calls.settings.push(args) },
+        './pet-cache': { PROTECT_DOG_ID: 1, getFriendDogState: () => 'unknown', getFriendDogId: () => 0 },
+        './scheduler': { setCanGetHelpExp: () => {}, getCanGetHelpExp: () => true, canGetExpByCandidates: () => true, isBadOperationLimitReached: () => false, getRemainingBadOperationTimes: () => 10 },
+    };
+    const module = { exports: {} };
+    class FakeDate extends Date { static now() { return now; } }
+    vm.runInNewContext(fs.readFileSync(path.join(__dirname, '../dist/services/friend/visit-strategy.js'), 'utf8'),
+        { require: name => { if (!(name in modules)) throw new Error(`Unexpected dependency: ${name}`); return modules[name]; }, module, exports: module.exports, process: { env: {} }, Date: FakeDate, console });
+    const service = module.exports;
+    const visit = (gid = 20) => service.visitFriend({ gid, name: `friend${gid}` }, { steal: 0, farming: 0, putBug: 0, putWeed: 0 }, 999, 'test');
+    return { service, calls, flags, lands, visit, setFailure: fn => failure = fn, advance: ms => now += ms };
+}
+
+for (const structured of [true, false]) {
+    test(`not-friend ${structured ? 'typed code' : 'gateway message'} stops batch fallback, later actions and following visits`, async () => {
+        const h = harness(); h.flags.friend_bad = true;
+        if (!structured) h.setFailure(() => new Error('gamepb.plantpb.PlantService.Farming code=1001048 不是好友无法操作'));
+        const result = await h.visit();
+        assert.equal(result.acted, false);
+        assert.equal(h.calls.farming.length, 1);
+        assert.equal(h.calls.bad.length, 0);
+        assert.deepEqual(h.calls.leave, [20]);
+        h.service.clearFriendsListCache();
+        await h.visit();
+        assert.deepEqual(h.calls.enter, [20]);
+        assert.equal(h.calls.settings.length, 0, 'temporary rejection must not delete or blacklist friends');
+    });
+}
+
+test('cooldown filters a stale refreshed friend list, affects only the target and expires after ten minutes', async () => {
+    const h = harness(); await h.service.getFriendsList();
+    await h.visit();
+    const friends = await h.service.getFriendsList();
+    assert.deepEqual(Array.from(friends, f => f.gid), [21]);
+    assert.equal(h.calls.lists, 2, 'a rejection must invalidate the list cache');
+    h.setFailure(() => null);
+    await h.visit(21);
+    assert.deepEqual(h.calls.enter, [20, 21]);
+    h.advance(599999); await h.visit(20);
+    assert.deepEqual(h.calls.enter, [20, 21]);
+    h.advance(1); await h.visit(20);
+    assert.deepEqual(h.calls.enter, [20, 21, 20]);
+    assert.equal(h.calls.settings.length, 0);
+});
+
+test('a not-friend response during per-land fallback stops the remaining land requests', async () => {
+    const h = harness();
+    h.setFailure((_gid, ids) => ids.length > 1 ? new Error('batch rejected') : Object.assign(new Error('不是好友无法操作'), { code: 1001048 }));
+    await h.visit();
+    assert.deepEqual(h.calls.farming.map(v => v.ids), [[1, 2], [1]]);
+    assert.deepEqual(h.calls.leave, [20]);
+});
+
+test('ordinary batch errors retain the existing per-land fallback', async () => {
+    const h = harness(); h.setFailure((_gid, ids) => ids.length > 1 ? new Error('ordinary batch rejected') : null);
+    const result = await h.visit();
+    assert.equal(result.acted, true);
+    assert.deepEqual(h.calls.farming.map(v => v.ids), [[1, 2], [1], [2]]);
+});
+
+test('manual farming propagates the rejection while still suppressing subsequent requests', async () => {
+    const h = harness();
+    await assert.rejects(h.service.doFriendOperation(20, 'farming', true), /不是好友/);
+    assert.deepEqual(h.calls.leave, [20]);
+    await h.visit();
+    assert.deepEqual(h.calls.enter, [20]);
+});
+
+for (const manual of [false, true]) {
+    test(`${manual ? 'manual' : 'automatic'} fallback retains confirmed partial success before a not-friend rejection`, async () => {
+        const h = harness(); h.flags.friend_bad = true; h.flags.friend_steal = true;
+        h.lands.push({ id: 3, plant: { id: 10, phases: [{ phase: 2 }], dry_num: 1 } });
+        h.setFailure((_gid, ids) => ids.length > 1 ? new Error('ordinary batch error')
+            : ids[0] === 2 ? Object.assign(new Error('不是好友无法操作'), { code: 1001048 }) : null);
+        const result = manual ? await h.service.doFriendOperation(20, 'farming') : await h.visit();
+        if (manual) { assert.equal(result.ok, false); assert.equal(result.count, 1); }
+        else assert.equal(result.acted, true);
+        assert.deepEqual(h.calls.farming.map(v => v.ids), [[1, 2, 3], [1], [2]]);
+        assert.deepEqual(h.calls.stats, [['helpFarming', 1]]);
+        assert.deepEqual(h.calls.leave, [20]);
+        assert.deepEqual(h.calls.bad, []);
+        assert.deepEqual(h.calls.steal, []);
+    });
+}
