index 0000000..fd1d2de
--- /dev/null
+++ b/core/tests/network-recovery-fence.test.js
@@ -0,0 +1,83 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createRecoveryFence } = require('../dist/services/network-recovery-fence');
+
+function fixture() {
+    const fence = createRecoveryFence();
+    let record = { id: '2', name: 'existing', platform: 'qq', code: 'old-code', marker: 'preserved' };
+    let running = false;
+    let writes = 0;
+    const adapter = {
+        getAccount: id => id === record.id ? { ...record } : null,
+        isRunning: () => running,
+        updateCode: (id, code) => { assert.equal(id, '2'); record.code = code; writes++; },
+        start: id => { assert.equal(id, '2'); running = true; return true; },
+    };
+    const body = () => ({ expected: fence.snapshot('2', record), code: 'new-code' });
+    return { fence, adapter, body, record: () => record, running: () => running,
+        writes: () => writes, setRunning: value => { running = value; } };
+}
+
+test('conditional recovery updates and starts existing account 2 while retaining other fields', () => {
+    const f = fixture();
+    assert.equal(f.fence.recover('2', f.body(), f.adapter).ok, true);
+    assert.equal(f.record().code, 'new-code');
+    assert.equal(f.record().marker, 'preserved');
+    assert.equal(f.running(), true);
+});
+
+test('a manual stop after snapshot invalidates recovery even if already stopped', () => {
+    const f = fixture(); const body = f.body();
+    f.fence.mark('2');
+    assert.equal(f.fence.recover('2', body, f.adapter).ok, false);
+    assert.equal(f.writes(), 0);
+    assert.equal(f.running(), false);
+});
+
+test('manual intent on another account does not invalidate account 2', () => {
+    const f = fixture(); const body = f.body();
+    f.fence.mark('1');
+    assert.equal(f.fence.recover('2', body, f.adapter).ok, true);
+});
+
+test('a changed credential before the atomic operation is not overwritten', () => {
+    const f = fixture(); const body = f.body();
+    f.record().code = 'user-code';
+    assert.equal(f.fence.recover('2', body, f.adapter).ok, false);
+    assert.equal(f.record().code, 'user-code');
+    assert.equal(f.writes(), 0);
+});
+
+test('a manual start before recovery is not restarted', () => {
+    const f = fixture(); const body = f.body();
+    f.setRunning(true);
+    assert.equal(f.fence.recover('2', body, f.adapter).ok, false);
+    assert.equal(f.writes(), 0);
+});
+
+test('a previous process epoch cannot recover after panel restart', () => {
+    const f = fixture(); const body = f.body();
+    const fresh = createRecoveryFence();
+    assert.equal(fresh.recover('2', body, f.adapter).ok, false);
+    assert.equal(f.writes(), 0);
+});
+
+test('reusing a consumed recovery snapshot cannot write a second time', () => {
+    const f = fixture(); const body = f.body();
+    assert.equal(f.fence.recover('2', body, f.adapter).ok, true);
+    f.setRunning(false);
+    assert.equal(f.fence.recover('2', body, f.adapter).ok, false);
+    assert.equal(f.writes(), 1);
+});
+
+test('other account, missing preconditions and empty or reused Code cannot recover', () => {
+    for (const change of [b => { b.expected = null; }, b => { b.code = ''; },
+                          b => { b.code = 'old-code'; }, b => { b.expected.version = -1; }]) {
+        const f = fixture(); const body = f.body(); change(body);
+        assert.equal(f.fence.recover('2', body, f.adapter).ok, false);
+        assert.equal(f.writes(), 0);
+    }
+    const f = fixture();
+    assert.equal(f.fence.recover('1', f.body(), f.adapter).ok, false);
+    assert.equal(f.writes(), 0);
+});
