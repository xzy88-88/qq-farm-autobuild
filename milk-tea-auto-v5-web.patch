index 0000000..9be34cd
--- /dev/null
+++ b/core/src/services/network-recovery-fence.ts
@@ -0,0 +1,41 @@
+export {};
+
+const { createHash, randomUUID } = require('node:crypto');
+
+function createRecoveryFence() {
+    const epoch = randomUUID();
+    const versions = new Map<string, number>();
+    const mark = (id: string): void => { versions.set(String(id), (versions.get(String(id)) || 0) + 1); };
+    const snapshot = (id: string, account: any) => ({
+        epoch,
+        version: versions.get(String(id)) || 0,
+        codeHash: createHash('sha256').update(String(account?.code || '')).digest('hex'),
+    });
+    return {
+        mark,
+        snapshot,
+        // Every dependency is synchronous. No other HTTP handler can run between
+        // this comparison, the Code update and start in Node's event loop.
+        recover(id: string, body: any, adapter: any) {
+            if (String(id) !== '2') return { ok: false, error: 'RecoveryAccountNotEnabled' };
+            const account = adapter.getAccount(id);
+            const expected = body?.expected;
+            const code = String(body?.code || '').trim();
+            if (!account || account.platform !== 'qq' || adapter.isRunning(id)) {
+                return { ok: false, error: 'RecoveryStateChanged' };
+            }
+            const current = snapshot(id, account);
+            if (!expected || expected.epoch !== current.epoch
+                || expected.version !== current.version || expected.codeHash !== current.codeHash
+                || !code || code === String(account.code || '')) {
+                return { ok: false, error: 'RecoveryStateChanged' };
+            }
+            mark(id); // A snapshot is single use even if saving or starting fails.
+            adapter.updateCode(id, code);
+            if (!adapter.start(id)) return { ok: false, error: 'RecoveryStartFailed' };
+            return { ok: true };
+        },
+    };
+}
+
+module.exports = { createRecoveryFence, recoveryFence: createRecoveryFence() };
