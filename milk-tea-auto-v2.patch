+
+for (const failed of [false, true]) {
+    test(`inventory lock revision begins before reading and is released after ${failed ? 'failure' : 'success'}`, async () => {
+        const h = harness(failed);
+        assert.equal(typeof h.api.getItemLockState, 'function');
+        const before = h.api.getItemLockState();
+        const pending = h.api.setItemsLocked([900], true);
+        const during = h.api.getItemLockState();
+        assert.equal(during.pending, 1);
+        assert.ok(during.revision > before.revision);
+        h.releaseBag();
+        if (failed) await assert.rejects(pending, /network unavailable/);
+        else assert.equal((await pending).changed, 1);
+        assert.equal(h.api.getItemLockState().pending, 0);
+        assert.ok(h.api.getItemLockState().revision > during.revision);
+    });
+}
